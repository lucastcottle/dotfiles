set $bg_soft    #32302f
set $bg_plum    #402a27
set $bg_delete  #402a27
set $surface    #3c3836
set $selection  #3c3836
set $border     #3c3836
set $float_bg   #2d2c2b

set $grey_warm  #665c54
set $comment    #928374
set $grey       #a89984
set $grey_mid   #a89984
set $grey_light #bdae93
set $grey_pale  #d5c4a1
set $silver     #ebdbb2
set $fg         #f9f5d7
set $fg_bright  #fbf1c7
set $cream      #f2e5bc

set $black #11110f
set $white #f9f5d7

set $keyword #e78a4e
